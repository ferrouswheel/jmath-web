---
import Layout from '../../layouts/Layout.astro';
import Detail from '../../components/CurveDetail.astro';
import { curves } from '../../curves.ts';
export function getStaticPaths() {
  return curves.map((curve) => ({
    params: { slug: curve.id },
    props: { curve },
  }));
}
const { curve } = Astro.props;
---

<Layout
  title={`${curve.name} curves`}
  description={curve.description}
  section="/curves"
  id="curves-page"
  accent={curve.color}
>
  <Detail curve={curve} />
</Layout>
<script>
  import { initializeCurve } from '../../client/curves.ts';
  initializeCurve();
</script>
