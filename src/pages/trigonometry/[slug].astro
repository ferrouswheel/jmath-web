---
import Layout from '../../layouts/Layout.astro';
import Detail from '../../components/TrigDetail.astro';
import { trigFunctions } from '../../trigonometry.ts';
export function getStaticPaths() {
  return trigFunctions.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}
const { item } = Astro.props;
---

<Layout
  title={item.name}
  description={item.description}
  section="/trigonometry"
  id="trigonometry-page"
  accent={item.inverse ? '#8270c7' : '#8270c7'}
>
  <Detail item={item} />
</Layout>
<script>
  import { renderTrigPage } from '../../client/trigonometry.ts';
  import { trigFunctions } from '../../trigonometry.ts';
  renderTrigPage(
    trigFunctions.find(
      (i) => i.id === location.pathname.split('/').filter(Boolean).at(-1),
    )!,
  );
</script>
