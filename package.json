{
  "name": "jmath-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --import tsx --import ./scripts/register-raw.mjs --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json README.md",
    "content": "node scripts/content.mjs",
    "predev": "npm run content",
    "prestart": "npm run content",
    "precheck": "npm run content",
    "prebuild": "npm run content",
    "pretest": "npm run content"
  },
  "dependencies": {
    "astro": "^7.3.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "marked-katex-extension": "^5.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "marked": "^18.0.12",
    "node": "^22.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.6.2"
  }
}
